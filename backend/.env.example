# ============================================
# Bloom Girl — Variables d'Environnement Backend
# Copier ce fichier en ".env" et remplir les valeurs
# ============================================

# Clé API Google Gemini (obtenir sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=votre_cle_gemini_ici

# URL de connexion PostgreSQL
# Format : postgresql://utilisateur:motdepasse@hôte:port/nom_base
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloomrose_db

# Clé secrète pour les tokens JWT (choisir une longue chaîne aléatoire)
JWT_SECRET_KEY=votre_cle_secrete_jwt_tres_longue_et_aleatoire

# Configuration Email SMTP (optionnel — pour les emails de bienvenue & reset password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM=Bloom Girl <noreply@bloomgirl.com>
